<%-- Door alert banners: ${alerts} are SecurityAlerts.Banner items, or ${databaseError} when they cannot be read. --%>
<c:choose>
    <c:when test="${not empty databaseError}">
        <div class="hs-alert"><c:out value="${databaseError}"/></div>
    </c:when>
    <c:otherwise>
        <c:forEach var="alert" items="${alerts}">
            <div class="hs-alert">
                <span class="hs-alert-text"><c:out value="${alert.text()}"/></span>
                <form method="post" action="${pageContext.request.contextPath}/devices">
                    <input type="hidden" name="deviceId" value="${alert.deviceId()}">
                    <button class="hs-alert-button" type="submit" name="action" value="lock">Lock door</button>
                </form>
            </div>
        </c:forEach>
    </c:otherwise>
</c:choose>
